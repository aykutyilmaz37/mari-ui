{
  "name": "@mari-ui/tokens",
  "version": "0.6.0",
  "description": "mari-ui design system'inin platform-agnostic token kaynağı (renk, spacing, radius, typography, shadow, z-index, motion).",
  "license": "MIT",
  "author": "Aykut Yılmaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutyilmaz37/mari-ui.git",
    "directory": "packages/tokens"
  },
  "homepage": "https://github.com/aykutyilmaz37/mari-ui#readme",
  "bugs": {
    "url": "https://github.com/aykutyilmaz37/mari-ui/issues"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tailwind-theme.css": "./dist/tailwind-theme.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./schema.json": "./dist/schema.json",
    "./package.json": "./package.json",
    "./fonts.css": "./fonts.css",
    "./fonts/*": "./fonts/*"
  },
  "files": [
    "dist",
    "fonts.css",
    "fonts"
  ],
  "scripts": {
    "build": "tsup && tsx scripts/build-css.ts && tsx scripts/build-schema.ts",
    "dev": "concurrently -n tsup,css,schema -c blue,magenta,green \"tsup --watch\" \"tsx watch scripts/build-css.ts\" \"tsx watch scripts/build-schema.ts\"",
    "generate:default-themes": "tsx scripts/build-default-themes.ts",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@mari-ui/eslint-config": "workspace:*",
    "@mari-ui/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "^9.1.2",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.12"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
