{
  "name": "@mari-ui/cli",
  "version": "0.4.0",
  "description": "mari-ui'ı bir tüketici projesine kuran ve AI ajan kural dosyalarını (Claude/Codex/Cursor/Gemini/Copilot) senkron tutan CLI.",
  "license": "MIT",
  "author": "Aykut Yılmaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutyilmaz37/mari-ui.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/aykutyilmaz37/mari-ui#readme",
  "bugs": {
    "url": "https://github.com/aykutyilmaz37/mari-ui/issues"
  },
  "type": "module",
  "bin": {
    "mari-ui": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@clack/prompts": "1.8.1",
    "@mari-ui/tokens": "workspace:*"
  },
  "devDependencies": {
    "@mari-ui/components": "workspace:*",
    "@mari-ui/eslint-config": "workspace:*",
    "@mari-ui/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9.17.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
