{
  "name": "@mari-ui/utils",
  "version": "0.1.0",
  "description": "mari-ui'ın UI'dan bağımsız cross-cutting özellik modülleri — datalayer/analytics, captcha wrapper'ları. @mari-ui/core'dan farkı: core headless UI mantığı taşır, bu paket üçüncü parti servis entegrasyonlarını sarmalar.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./datalayer": {
      "types": "./dist/datalayer.d.ts",
      "import": "./dist/datalayer.js"
    },
    "./captcha": {
      "types": "./dist/captcha.d.ts",
      "import": "./dist/captcha.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "@mari-ui/eslint-config": "workspace:*",
    "@mari-ui/tsconfig": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  }
}
