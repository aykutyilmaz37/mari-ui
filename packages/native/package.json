{
  "name": "@mari-ui/native",
  "version": "0.1.0",
  "description": "mari-ui'ın React Native katmanı. StyleSheet + @mari-ui/tokens JS objesi kullanır — NativeWind veya başka bir babel/metro eklentisi gerektirmez, tüketiciye sıfır ek kurulum şartı koyar.",
  "license": "MIT",
  "author": "Aykut Yılmaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutyilmaz37/mari-ui.git",
    "directory": "packages/native"
  },
  "homepage": "https://github.com/aykutyilmaz37/mari-ui#readme",
  "bugs": {
    "url": "https://github.com/aykutyilmaz37/mari-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./stories": {
      "types": "./src/stories/registry.ts",
      "default": "./src/stories/registry.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0",
    "react-native-svg": ">=15.0.0"
  },
  "dependencies": {
    "@mari-ui/core": "workspace:*",
    "@mari-ui/tokens": "workspace:*",
    "qrcode-generator": "^1.5.2"
  },
  "devDependencies": {
    "@mari-ui/eslint-config": "workspace:*",
    "@mari-ui/tsconfig": "workspace:*",
    "@storybook/react": "^8.6.18",
    "@types/react": "^19.0.2",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "^9.17.0",
    "lucide-react-native": "^1.52.0",
    "react": "^19.2.8",
    "react-native": "^0.87.1",
    "react-native-svg": "15.15.4",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
