{
  "name": "@mari-ui/core",
  "version": "0.3.1",
  "description": "mari-ui'ın web ve native arasında paylaşılan headless katmanı: ortak tipler, variant çözümleme, cn() ve headless hook'lar.",
  "license": "MIT",
  "author": "Aykut Yılmaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aykutyilmaz37/mari-ui.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/aykutyilmaz37/mari-ui#readme",
  "bugs": {
    "url": "https://github.com/aykutyilmaz37/mari-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "dependencies": {
    "@mari-ui/tokens": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.3.0"
  },
  "devDependencies": {
    "@mari-ui/eslint-config": "workspace:*",
    "@mari-ui/tsconfig": "workspace:*",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "esbuild-plugin-preserve-directives": "^0.0.11",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
