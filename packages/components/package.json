  "scripts": {
    "build": "NODE_OPTIONS=--max-old-space-size=8192 tsup && pnpm build:css && pnpm build:manifest",
    "build:css": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --minify",
    "build:css:watch": "tailwindcss -i ./src/styles.css -o ./dist/styles.css --watch",
    "build:manifest": "tsx scripts/build-manifest.ts",
    "dev": "concurrently -n tsup,css -c blue,magenta \"NODE_OPTIONS=--max-old-space-size=8192 tsup --watch\" \"pnpm build:css:watch\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "embla-carousel-autoplay": "^8.0.0",
