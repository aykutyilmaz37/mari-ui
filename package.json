{
  "name": "mari-ui",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "storybook": "turbo run storybook --filter=@mari-ui/docs",
    "native": "pnpm --filter @mari-ui/native-studio start",
    "native:web": "pnpm --filter @mari-ui/native-studio web",
    "clean": "turbo run clean && rm -rf node_modules",
    "audit": "pnpm audit --audit-level critical",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build --filter=./packages/* && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "2.29.7",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "license": "MIT"
}
